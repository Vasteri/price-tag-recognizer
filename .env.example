# Версии образов
NGINX_VERSION=1.29.5
REDIS_VERSION=alpine3.23
FLOWER_VERSION=2.0.1
PROMETHEUS_VERSION=v2.50.1
PROMTAIL_VERSION=3.6.11
LOKI_VERSION=3.7.2
GRAFANA_VERSION=10.4.0
LLAMA_VERSION=server-cuda13-b9821 #@sha256:649b128c557eb6d675afac69bac443ce1b709cd143e85ef10b67f1639de4cbb0

# Внешний порт Nginx 
NGINX_PORT=80

# Параметры celery worker и backend
CELERY_NAME=backend
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/shared/uploads
RESULT_DIR=/shared/results

# Параметры только у celery worker
LLM_BASE_URL=http://llama-cpp-server:8000/v1
LLM_MODEL=Qwen3-VL-2B-Instruct-GGUF
ENABLE_OCR=false
YOLO_MODEL=/models/yolo-price-tag-detection.pt

# Параметры LLAMA
MODEL_PATH=/models/Qwen3-VL-2B-Instruct-Q4_K_M.gguf
MMPROJ_PATH=/models/mmproj-Qwen3-VL-2B-Instruct-F16.gguf
CONTEXT_SIZE=8192
GPU_LAYERS=99
IMAGE_MIN_TOKENS=1024 # для корректной работы модели Qwen с изображениями

# Профили, запускаемые по умолчанию
COMPOSE_PROFILES=monitoring